+// A stationary motor is a brake. At an active stop, solve the brake and
+// the stop independently instead of injecting fmax as an external torque.
+// The latter needs a cancelling stop impulse and loses accuracy for strong
+// ragdoll brakes. Three axes need at most six rows (the joint cache capacity).
+static bool amotorSeparateBrakeAndStop (const dxJointLimitMotor &limot)
+{
+  return limot.fmax > 0 && limot.vel == 0 && limot.limit != 0 &&
+    limot.lostop != limot.histop;
+}
