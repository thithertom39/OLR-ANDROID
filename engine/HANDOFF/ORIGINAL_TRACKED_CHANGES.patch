+    return double(m._11) * (double(m._22)*m._33-double(m._23)*m._32) -
+        double(m._12) * (double(m._21)*m._33-double(m._23)*m._31) +
+        double(m._13) * (double(m._21)*m._32-double(m._22)*m._31);
