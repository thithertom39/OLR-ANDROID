+bool RagdollTraceTake(unsigned phase)
+{
+    std::lock_guard<std::mutex> lock(ragdollTraceBudget.mutex);
+    unsigned& count = phase == 0 ? ragdollTraceBudget.set :
+        phase == 1 ? ragdollTraceBudget.callback : ragdollTraceBudget.activation;
+    const unsigned limit = phase == 2 ? 4 : 8;
+    if (count >= limit) return false;
+    ++count;
+    return true;
+}
