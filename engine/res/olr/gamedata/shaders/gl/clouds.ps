#include "common.h"
#include "iostructs\p_clouds.h"

Texture2D	s_clouds0;
Texture2D	s_clouds1;

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 	_main	( v2p I )
{
	float3 s_0 = tex2D(s_clouds0, I.tc0).rgb + tex2D(s_clouds0, I.tc1).rgb;
	float3 s_1 = tex2D(s_clouds1, I.tc0).rgb + tex2D(s_clouds1, I.tc1).rgb;
	float3 cloud_rgb = I.color.rgb * lerp(s_0, s_1, L_ambient.w);

#ifndef USE_VTF
	float4 low, high;
	float scale = tex2D(s_tonemap, float2(0.5, 0.5)).x;
	tonemap(low, high, cloud_rgb, scale);
	cloud_rgb = low.rgb;
#endif

	// SoC R2 uses weather opacity and dome fade, independent of DDS alpha.
	return float4(cloud_rgb, I.color.a);
}
