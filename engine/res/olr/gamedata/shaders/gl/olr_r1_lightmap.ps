#include "common.h"

// This optional OLR experiment adds only baked lighting. R2 continues to
// provide ambient, hemispheric, static-sun and dynamic point/spot light.
layout(location = TEXCOORD0) in float2 base_uv;
layout(location = FOG) in float fog_visibility;
#ifdef OLR_R1_FORWARD
layout(location = TEXCOORD2) in float2 hemi_uv;
layout(location = TEXCOORD5) in float3 olr_forward_world_pos;
layout(location = TEXCOORD6) in float3 olr_forward_world_normal;
uniform float4 olr_forward_spot_pos;   // xyz position, w = inverse squared radius
uniform float4 olr_forward_spot_dir;   // xyz direction, w = cosine of half cone
uniform float4 olr_forward_spot_color; // RGB intensity, w = enabled
uniform float4 olr_forward_omni_pos;   // near POINT position, w = 1/range^2
uniform float4 olr_forward_omni_color; // RGB intensity, w = enabled
#endif
#ifdef OLR_R1_DETAIL
layout(location = TEXCOORD3) in float2 detail_uv;
layout(location = TEXCOORD4) in float2 detail_weights;
#endif
#ifdef OLR_R1_VERTEX
layout(location = COLOR0) in float3 vertex_light;
#else
layout(location = TEXCOORD1) in float2 lightmap_uv;
layout(location = COLOR0) in float3 hemi_light;
layout(location = COLOR1) in float3 sun_light;
#endif

layout(location = 0) out float4 out_color;

void main()
{
#ifdef OLR_R1_VERTEX
    float3 baked = vertex_light;
#else
    float3 baked = tex2D(s_lmap, lightmap_uv).rgb;
#endif

#ifdef OLR_R1_FORWARD
    // Native forward static shading: no G-buffer dependency or second light
    // accumulation pass. Use the source OLR lightmap RGB + hemi + sun alpha.
    float4 diffuse = tex2D(s_base, base_uv);
    float4 lm = tex2D(s_lmap, lightmap_uv);
    float3 light = L_ambient.rgb + lm.rgb + sun_light * lm.a + hemi_light * p_hemi(hemi_uv);

    // Dynamic torch on static surfaces in the SAME forward pass; no G-buffer
    // and no second geometry submission. Stage 1 uses diffuse cone falloff
    // without a shadow-map lookup or projected cookie.
    if (olr_forward_spot_color.w > 0.5)
    {
        float3 light_to_surface = olr_forward_world_pos - olr_forward_spot_pos.xyz;
        float distance_sq = dot(light_to_surface, light_to_surface);
        float range_sq = distance_sq * olr_forward_spot_pos.w;
        if (distance_sq > 0.0001 && range_sq < 1.0)
        {
            float inv_distance = inversesqrt(distance_sq);
            float3 light_ray = light_to_surface * inv_distance;
            float angle_cos = dot(light_ray, olr_forward_spot_dir.xyz);
            float beam = smoothstep(olr_forward_spot_dir.w,
                min(olr_forward_spot_dir.w + 0.08, 0.999), angle_cos);
            float ndotl = max(0.0, dot(normalize(olr_forward_world_normal), -light_ray));
            float falloff = 1.0 - range_sq;
            light += olr_forward_spot_color.rgb * (ndotl * beam * falloff * falloff);
        }
    }
    // The torch's close-range POINT source lights nearby geometry even
    // outside the spotlight cone. It is unshadowed in the original R2 path.
    if (olr_forward_omni_color.w > 0.5)
    {
        float3 light_to_surface = olr_forward_world_pos - olr_forward_omni_pos.xyz;
        float distance_sq = dot(light_to_surface, light_to_surface);
        float range_sq = distance_sq * olr_forward_omni_pos.w;
        if (distance_sq > 0.0001 && range_sq < 1.0)
        {
            float3 to_light = -light_to_surface * inversesqrt(distance_sq);
            float ndotl = max(0.0, dot(normalize(olr_forward_world_normal), to_light));
            float falloff = 1.0 - range_sq;
            light += olr_forward_omni_color.rgb * (ndotl * falloff * falloff);
        }
    }
    float3 shaded = diffuse.rgb * light * 2.0;
#ifdef OLR_R1_DETAIL
    shaded *= (tex2D(s_detail, detail_uv).rgb * detail_weights.x + detail_weights.y) * 2.0;
#endif
    shaded = mix(fog_color.rgb, shaded, fog_visibility);
    out_color = float4(shaded, diffuse.a * fog_visibility * fog_visibility);
#elif defined(OLR_R1_ACCUM)
    // The HDR accumulator stores illumination; combine_1 applies albedo and
    // fog exactly once, together with the regular dynamic lighting.
    out_color = float4(baked, 0.0);
#else
    // Fallback when the device cannot blend into RGBA16F: add the shaded
    // baked component to LDR rather than replacing flashlight-lit pixels.
    float3 shaded = tex2D(s_base, base_uv).rgb * baked;
#ifdef OLR_R1_DETAIL
    shaded *= (tex2D(s_detail, detail_uv).rgb * detail_weights.x + detail_weights.y) * 2.0;
#endif
    shaded *= fog_visibility;
    out_color = float4(shaded, 0.0);
#endif
}
